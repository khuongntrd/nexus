@page "/projects"

<PageTitle>Projects - Nexus</PageTitle>

<FluentGrid Spacing="3" AdaptiveRendering="true">
    <FluentGridItem xs="12">
        <FluentCard class="surface-card">
            <h2>Projects</h2>
        </FluentCard>
    </FluentGridItem>

    <FluentGridItem xs="12">
        <FluentCard class="surface-card">
            <h3>Planned project cards</h3>
            <ul class="clean-list">
                <li>Personal Sprint</li>
                <li>Work Backlog</li>
                <li>Open Source Maintenance</li>
            </ul>
        </FluentCard>
    </FluentGridItem>
</FluentGrid>
